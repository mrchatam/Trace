{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrchatam/Trace/evals/perf/schema-gate-h.json",
  "title": "Trace Gate H planted performance-ladder metrics",
  "type": "object",
  "required": [
    "schema_version",
    "gate",
    "suite",
    "dry_run",
    "named_test",
    "rungs",
    "thresholds",
    "t0_skip_ok",
    "incremental_isolation_ok",
    "go_adapter_exercised",
    "s01_hooks",
    "s02_hooks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "gate": {
      "type": "string",
      "const": "H"
    },
    "suite": {
      "type": "string",
      "const": "perf"
    },
    "dry_run": {
      "type": "boolean"
    },
    "named_test": {
      "type": "string",
      "minLength": 1
    },
    "rungs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "approx_loc",
          "file_count",
          "initial_index_ms",
          "incremental_index_ms",
          "db_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "approx_loc": {
            "type": "integer",
            "minimum": 0
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "initial_index_ms": {
            "type": "integer",
            "minimum": 0
          },
          "incremental_index_ms": {
            "type": "integer",
            "minimum": 0
          },
          "db_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": true
    },
    "t0_skip_ok": {
      "type": "boolean"
    },
    "incremental_isolation_ok": {
      "type": "boolean"
    },
    "go_adapter_exercised": {
      "type": "boolean"
    },
    "s01_hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "s02_hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trace_version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
