  "decisions": [
    {
      "id": "rl010000-0000-4000-8000-0000000000a1",
      "title": "Shared list envelope contract",
      "body": "Endpoints returning note collections use items + next_cursor."
    },
    {
      "id": "rl010000-0000-4000-8000-0000000000a2",
      "title": "Cursor over offset",
      "body": "Offset/page params are rejected to avoid drift regressions."
    },
    {
      "id": "rl010000-0000-4000-8000-0000000000a3",
      "title": "Bearer on mutating routes",
      "body": "Mutations require Authorization: Bearer NOTES_API_KEY; query api_key is rejected."
    },
